---
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
---

<a
	class="book-call-button"
	href="https://cal.com/jcaron/30min"
	target="_blank"
	rel="noopener noreferrer"
>
	Book a Call
</a>

<style>
	.book-call-button {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.9rem;
		border-radius: 2rem;
		background: rgb(0 107 230);
		color: #fff;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		line-height: 1.4;
	}
	.book-call-button:hover {
		background: rgb(0 90 195);
	}
</style>
